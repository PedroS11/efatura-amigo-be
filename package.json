{
  "name": "efatura-amigo-be",
  "version": "0.1.0",
  "bin": {
    "efatura-amigo-be": "cdk/index.js"
  },
  "scripts": {
    "build": "node esbuild.deploy.mjs && tsc -noEmit --incremental",
    "build:local": "node esbuild.local.mjs && tsc -noEmit --incremental",
    "watch": "tsc -w",
    "cdk": "cdk synth",
    "lint": "biome check src cdk",
    "lint:fix": "biome check --write src cdk",
    "prepare": "husky install",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "2.1136.0",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-sqs": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "algoliasearch": "^5.56.0",
    "aws-cdk-lib": "2.265.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.19.0",
    "constructs": "^10.8.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.9",
    "telegraf": "^4.16.3"
  }
}
